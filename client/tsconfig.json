{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Existing JS logic (lib/, store/, services/) is kept as-is; only new
       view components are TypeScript. */
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/*"],
      "@ds/*": ["./design-system/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "design-system"]
}
