{
  "name": "portainer-run",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "bun run --cwd client dev",
    "start": "bun run server/server.js",
    "build": "bun run --cwd client build",
    "preview": "bun run --cwd client preview",
    "docker:run": "bash scripts/docker-run.sh",
    "lint": "bun run --cwd client lint",
    "typecheck": "bun run --cwd client typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^17.0.7",
    "prettier": "^3.4.2"
  }
}
