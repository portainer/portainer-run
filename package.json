{
  "name": "portainer-run",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm --dir client run dev",
    "start": "node server/server.js",
    "test": "node --test \"server/**/*.test.js\" \"test/**/*.test.js\" && pnpm --filter portainer-run-ui test",
    "test:coverage": "c8 node --test \"server/**/*.test.js\" \"test/**/*.test.js\" && pnpm --filter portainer-run-ui test:coverage",
    "test:lifecycle": "node scripts/test-chart-lifecycle.ts",
    "build": "pnpm --dir client run build && node scripts/check-bundle.ts && node scripts/check-licenses.ts --notices client/dist/THIRD_PARTY_NOTICES.txt",
    "preview": "pnpm --dir client run preview",
    "docker:run": "bash scripts/docker-run.sh",
    "redeploy": "node scripts/redeploy.ts",
    "lint": "pnpm --dir client run lint && eslint .",
    "lint:chart": "node scripts/check-chart.ts",
    "lint:deep": "jscpd . && knip && node scripts/check-licenses.ts && pnpm run lint:repo",
    "lint:repo": "node scripts/check-repo-rules.ts && node scripts/check-doc-links.ts",
    "typecheck": "pnpm --dir client run typecheck && tsc -p scripts/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.6",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^15.15.0",
    "husky": "^8.0.3",
    "jscpd": "^5.3.2",
    "knip": "^6.38.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
