{
  "version": "1",
  "templates": [
    {
      "id": "wordpress-mysql",
      "name": "WordPress + MySQL",
      "description": "WordPress CMS with a MySQL 8 database. Suitable for blogs, small sites, and content teams.",
      "category": "cms",
      "icon": "wordpress",
      "manifest": {
        "apiVersion": "serving.knative.dev/v1",
        "kind": "Service",
        "metadata": {
          "name": "wordpress",
          "annotations": {
            "autoscaling.knative.dev/minScale": "1"
          }
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "wordpress",
                  "image": "wordpress:latest",
                  "ports": [
                    {
                      "containerPort": 80
                    }
                  ],
                  "env": [
                    {
                      "name": "WORDPRESS_DB_HOST",
                      "value": "localhost"
                    },
                    {
                      "name": "WORDPRESS_DB_USER",
                      "value": "wpuser"
                    },
                    {
                      "name": "WORDPRESS_DB_PASSWORD",
                      "value": "changeme"
                    },
                    {
                      "name": "WORDPRESS_DB_NAME",
                      "value": "wordpress"
                    }
                  ],
                  "resources": {
                    "requests": {
                      "cpu": "100m",
                      "memory": "128Mi"
                    },
                    "limits": {
                      "cpu": "500m",
                      "memory": "512Mi"
                    }
                  },
                  "volumeMounts": [
                    {
                      "name": "wordpress-data",
                      "mountPath": "/var/www/html"
                    }
                  ]
                },
                {
                  "name": "mysql",
                  "image": "mysql:8.0",
                  "env": [
                    {
                      "name": "MYSQL_DATABASE",
                      "value": "wordpress"
                    },
                    {
                      "name": "MYSQL_USER",
                      "value": "wpuser"
                    },
                    {
                      "name": "MYSQL_PASSWORD",
                      "value": "changeme"
                    },
                    {
                      "name": "MYSQL_RANDOM_ROOT_PASSWORD",
                      "value": "1"
                    }
                  ],
                  "resources": {
                    "requests": {
                      "cpu": "100m",
                      "memory": "256Mi"
                    },
                    "limits": {
                      "cpu": "500m",
                      "memory": "512Mi"
                    }
                  },
                  "volumeMounts": [
                    {
                      "name": "mysql-data",
                      "mountPath": "/var/lib/mysql"
                    }
                  ]
                }
              ],
              "volumes": [
                {
                  "name": "wordpress-data",
                  "persistentVolumeClaim": {
                    "claimName": "wordpress-data"
                  }
                },
                {
                  "name": "mysql-data",
                  "persistentVolumeClaim": {
                    "claimName": "mysql-data"
                  }
                }
              ]
            }
          }
        }
      },
      "type": "portainer-run",
      "allowCustomise": true
    },
    {
      "id": "nginx",
      "name": "Nginx",
      "description": "Nginx web server. Use as a static file server, reverse proxy, or starting point for custom web applications.",
      "category": "web",
      "icon": "nginx",
      "manifest": {
        "apiVersion": "serving.knative.dev/v1",
        "kind": "Service",
        "metadata": {
          "name": "nginx",
          "annotations": {
            "autoscaling.knative.dev/minScale": "1"
          }
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "nginx",
                  "image": "nginx:latest",
                  "ports": [
                    {
                      "containerPort": 80
                    }
                  ],
                  "resources": {
                    "requests": {
                      "cpu": "50m",
                      "memory": "64Mi"
                    },
                    "limits": {
                      "cpu": "200m",
                      "memory": "128Mi"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "type": "portainer-run",
      "allowCustomise": true
    },
    {
      "id": "postgres-pgadmin",
      "name": "PostgreSQL + pgAdmin",
      "description": "PostgreSQL 16 database with pgAdmin 4 web interface for administration. Suitable for development and internal tooling.",
      "category": "database",
      "icon": "postgres",
      "manifest": {
        "apiVersion": "serving.knative.dev/v1",
        "kind": "Service",
        "metadata": {
          "name": "postgres",
          "annotations": {
            "autoscaling.knative.dev/minScale": "1"
          }
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "pgadmin",
                  "image": "dpage/pgadmin4:latest",
                  "ports": [
                    {
                      "containerPort": 80
                    }
                  ],
                  "env": [
                    {
                      "name": "PGADMIN_DEFAULT_EMAIL",
                      "value": "admin@example.com"
                    },
                    {
                      "name": "PGADMIN_DEFAULT_PASSWORD",
                      "value": "changeme"
                    },
                    {
                      "name": "PGADMIN_CONFIG_SERVER_MODE",
                      "value": "False"
                    }
                  ],
                  "resources": {
                    "requests": {
                      "cpu": "100m",
                      "memory": "128Mi"
                    },
                    "limits": {
                      "cpu": "500m",
                      "memory": "512Mi"
                    }
                  }
                },
                {
                  "name": "postgres",
                  "image": "postgres:16",
                  "env": [
                    {
                      "name": "POSTGRES_DB",
                      "value": "app"
                    },
                    {
                      "name": "POSTGRES_USER",
                      "value": "appuser"
                    },
                    {
                      "name": "POSTGRES_PASSWORD",
                      "value": "changeme"
                    },
                    {
                      "name": "PGDATA",
                      "value": "/var/lib/postgresql/data/pgdata"
                    }
                  ],
                  "resources": {
                    "requests": {
                      "cpu": "100m",
                      "memory": "256Mi"
                    },
                    "limits": {
                      "cpu": "500m",
                      "memory": "512Mi"
                    }
                  },
                  "volumeMounts": [
                    {
                      "name": "postgres-data",
                      "mountPath": "/var/lib/postgresql/data"
                    }
                  ]
                }
              ],
              "volumes": [
                {
                  "name": "postgres-data",
                  "persistentVolumeClaim": {
                    "claimName": "postgres-data"
                  }
                }
              ]
            }
          }
        }
      },
      "type": "portainer-run",
      "allowCustomise": true
    },
    {
      "id": "redis",
      "name": "Redis",
      "description": "Redis 7 in-memory data store. Use for caching, sessions, queues, and pub/sub messaging.",
      "category": "database",
      "icon": "redis",
      "manifest": {
        "apiVersion": "serving.knative.dev/v1",
        "kind": "Service",
        "metadata": {
          "name": "redis",
          "annotations": {
            "autoscaling.knative.dev/minScale": "1"
          }
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "redis",
                  "image": "redis:7-alpine",
                  "ports": [
                    {
                      "containerPort": 6379
                    }
                  ],
                  "resources": {
                    "requests": {
                      "cpu": "50m",
                      "memory": "64Mi"
                    },
                    "limits": {
                      "cpu": "200m",
                      "memory": "256Mi"
                    }
                  },
                  "volumeMounts": [
                    {
                      "name": "redis-data",
                      "mountPath": "/data"
                    }
                  ]
                }
              ],
              "volumes": [
                {
                  "name": "redis-data",
                  "persistentVolumeClaim": {
                    "claimName": "redis-data"
                  }
                }
              ]
            }
          }
        }
      },
      "type": "portainer-run",
      "allowCustomise": true
    },
    {
      "id": "ghost",
      "name": "Ghost",
      "description": "Ghost publishing platform with MySQL 8 database. A modern alternative to WordPress for blogs and newsletters.",
      "category": "cms",
      "icon": "ghost",
      "manifest": {
        "apiVersion": "serving.knative.dev/v1",
        "kind": "Service",
        "metadata": {
          "name": "ghost",
          "annotations": {
            "autoscaling.knative.dev/minScale": "1"
          }
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "ghost",
                  "image": "ghost:latest",
                  "ports": [
                    {
                      "containerPort": 2368
                    }
                  ],
                  "env": [
                    {
                      "name": "database__client",
                      "value": "mysql"
                    },
                    {
                      "name": "database__connection__host",
                      "value": "localhost"
                    },
                    {
                      "name": "database__connection__user",
                      "value": "ghost"
                    },
                    {
                      "name": "database__connection__password",
                      "value": "changeme"
                    },
                    {
                      "name": "database__connection__database",
                      "value": "ghost"
                    }
                  ],
                  "resources": {
                    "requests": {
                      "cpu": "100m",
                      "memory": "256Mi"
                    },
                    "limits": {
                      "cpu": "500m",
                      "memory": "512Mi"
                    }
                  },
                  "volumeMounts": [
                    {
                      "name": "ghost-data",
                      "mountPath": "/var/lib/ghost/content"
                    }
                  ]
                },
                {
                  "name": "mysql",
                  "image": "mysql:8.0",
                  "env": [
                    {
                      "name": "MYSQL_DATABASE",
                      "value": "ghost"
                    },
                    {
                      "name": "MYSQL_USER",
                      "value": "ghost"
                    },
                    {
                      "name": "MYSQL_PASSWORD",
                      "value": "changeme"
                    },
                    {
                      "name": "MYSQL_RANDOM_ROOT_PASSWORD",
                      "value": "1"
                    }
                  ],
                  "resources": {
                    "requests": {
                      "cpu": "100m",
                      "memory": "256Mi"
                    },
                    "limits": {
                      "cpu": "500m",
                      "memory": "512Mi"
                    }
                  },
                  "volumeMounts": [
                    {
                      "name": "mysql-data",
                      "mountPath": "/var/lib/mysql"
                    }
                  ]
                }
              ],
              "volumes": [
                {
                  "name": "ghost-data",
                  "persistentVolumeClaim": {
                    "claimName": "ghost-data"
                  }
                },
                {
                  "name": "mysql-data",
                  "persistentVolumeClaim": {
                    "claimName": "mysql-data"
                  }
                }
              ]
            }
          }
        }
      },
      "type": "portainer-run",
      "allowCustomise": true
    },
    {
      "id": "nginx-statefulset",
      "name": "Nginx StatefulSet",
      "type": "kubernetes",
      "description": "Nginx deployed as a StatefulSet with persistent storage. Use when you need stable pod identity or ordered deployment.",
      "category": "web",
      "allowCustomise": true,
      "manifest": "apiVersion: apps/v1\nkind: StatefulSet\nmetadata:\n  name: nginx-statefulset\n  labels:\n    app: nginx-statefulset\n    managed-by: portainer-run\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app: nginx-statefulset\n  serviceName: nginx-statefulset\n  template:\n    metadata:\n      labels:\n        app: nginx-statefulset\n        managed-by: portainer-run\n    spec:\n      containers:\n        - name: nginx-statefulset\n          image: nginx:latest\n          imagePullPolicy: Always\n          ports:\n            - containerPort: 80\n          resources:\n            requests:\n              cpu: 50m\n              memory: 64Mi\n            limits:\n              cpu: 200m\n              memory: 128Mi\n          volumeMounts:\n            - name: nginx-statefulset-0\n              mountPath: /usr/share/nginx/html\n  volumeClaimTemplates:\n    - metadata:\n        name: nginx-statefulset-0\n      spec:\n        accessModes: [ReadWriteOnce]\n        resources:\n          requests:\n            storage: 1Gi\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: nginx-statefulset\n  labels:\n    app: nginx-statefulset\n    managed-by: portainer-run\nspec:\n  selector:\n    app: nginx-statefulset\n  type: NodePort\n  ports:\n    - port: 80\n      targetPort: 80\n      protocol: TCP\n"
    },
    {
      "id": "postgresql-helm",
      "name": "PostgreSQL",
      "type": "helm",
      "description": "PostgreSQL database via the Bitnami Helm chart. Production-ready with persistent storage, configurable credentials, and optional replication.",
      "category": "database",
      "allowCustomise": true,
      "helm": {
        "repo": "https://charts.bitnami.com/bitnami",
        "chart": "postgresql",
        "version": "16.2.1",
        "defaultValues": "auth:\n  postgresPassword: changeme\n  database: app\nprimary:\n  persistence:\n    enabled: true\n    size: 8Gi\n  resources:\n    requests:\n      cpu: 250m\n      memory: 256Mi\n    limits:\n      cpu: 500m\n      memory: 512Mi\n"
      }
    }
  ]
}